## begin ## meta-data
readonly __APPNAME=$( basename "${BASH_SOURCE[0]}" )
readonly __APPVERSION=2.1.0
readonly __SUPPORTED_OS=(MAC LINUX-DEBIAN)
readonly __SUPPORTED_ARCH=(X32 X64 A32 A64)
readonly __DEBUG=FALSE
## end ## meta-data

##
# @info     logging functions
##
function common::log() { echo "[info]: $@" 1>&2; }
function common::log_linebreak() { echo "" 1>&2; }
function common::warn() { echo "[warn]: $@" 1>&2; }
function common::error() { echo "[error]: $@" 1>&2; }
function common::error_exit() { echo "[error]: $@" 1>&2; exit 1;}
function common::debug () { [ "$__DEBUG" == "TRUE" ] && echo "[debug]: $@" 1>&2; }

##
# @info     string functions
##
function common::trimall() { echo $(echo "$@" | tr -d '[ \t]' | tr 'A-Z' 'a-z'); }
function common::lowercase() { echo "$@" | sed "y/ABCDEFGHIJKLMNOPQRSTUVWXYZ/abcdefghijklmnopqrstuvwxyz/"; }
function common::uppercase() { echo "$@" | sed "y/abcdefghijklmnopqrstuvwxyz/ABCDEFGHIJKLMNOPQRSTUVWXYZ/"; }
function common::join_by() { local d=$1; shift; echo -n "$1"; shift; printf "%s" "${@/#/$d}"; }

##
# @info     math functions
##
function common::random_2() { echo ${RANDOM:0-2}; }
function common::random_1() { echo ${RANDOM:0-1}; }

##
# @info     file functions
##
function common::basedir() { echo $( dirname "$1" ); }

##
# @info     returns the current os enum [WINDOWS/MAC/LINUX]
# @return   os enum [WINDOWS , MAC , LINUX]
##
function common::get_os() {
    local _ossig=`uname -s 2> /dev/null | tr "[:upper:]" "[:lower:]" 2> /dev/null`
    local _os_base="UNKNOWN"
    case "$_ossig" in
        *windowsnt*) _os_base="WINDOWS";;
        *darwin*) _os_base="MAC";;
        *linux*)    
            if [ -f /etc/redhat-release ] ; then
                _os_base="LINUX-REDHAT"
            elif [ -f /etc/SuSE-release ] ; then
                _os_base="LINUX-SUSE"
            elif [ -f /etc/mandrake-release ] ; then
                _os_base="LINUX-MANDRAKE"
            elif [ -f /etc/debian_version ] ; then
                _os_base="LINUX-DEBIAN"             
            else
                _os_base="LINUX"            
            fi
            ;;
        *) _os_base="UNKNOWN";;
    esac
    echo $_os_base
}

##
# @info     returns and enum defining to the system archictcture [A=ARM X=INTEL]
# @return   [X32, X64, A32, A64]
##
function common::get_arch(){
    local _arch="$(uname -m)"  # -i is only linux, -m is linux and apple
    local _arch_key="UNKNOWN"
    
    if [[ "$_arch" = x86_64* ]]; then
        if [[ "$(uname -a)" = *ARM64* ]]; then
            _arch_key='A64'
        else
            _arch_key='X64'
        fi
    elif [[ "$_arch" = i*86 ]]; then
        _arch_key='X32'
    elif [[ "$_arch" = arm* ]]; then
        _arch_key='A32'
    elif test "$_arch" = aarch64; then
        _arch_key='A64'
    fi
    
    echo $_arch_key
}

##
# @info     returns the current cpu architure
# @return   cpu architure [x86_64 , x86]
##
function common::get_arch_raw(){
    local _arch="UNKNOWN"
    case "$(common::get_os)" in
        WINDOWS) _arch=`uname -p 2> /dev/null`;;
        MAC)     [ "$(sysctl hw.cpu64bit_capable | awk '{print $2}')" == "1" ] && _arch=x86_64 || _arch=x86;;
        LINUX*)  _arch=`uname -m 2> /dev/null`;;
        *)       _arch="UNKNOWN";;
    esac
    
    if [ "$_arch" == "i686" ]; then
        _arch="x86";
    fi

    echo $_arch
}

##
# @info     is arm processor
# @return   true / false
##
function common::is_arm(){
    if [[ "$(common::get_arch)" =~ ^A.* ]]; then
        # 0 = true
        #return 0
        true  
    else
        # 1 = false
        #return 1
        false
    fi 
}

##
# @info    bootstrap
##
function __bootstrap() {    
    readonly __BASEDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    readonly __BASEDIRNAME=$( basename "$__BASEDIR" )
    readonly __TIMESTAMP=$(date +%Y%m%d%H%M%S${RANDOM:0-2})
}
# --------------------------------------------------------------------
# common : end
# --------------------------------------------------------------------

function __map_commands() {
    # grep
    __GREP=grep
    # cat
    __CAT=cat
    # sed
    if sed --version 2>&1 | grep -q GNU; then
        if sed -c 2>&1 | grep -q invalid; then
            __SED="sed -i "
        else
            __SED="sed -c -i "
        fi
    else
        #mac sed
        __SED="/usr/bin/sed -i .$__TIMESTAMP "
    fi
}

function __init() {
    __bootstrap
    # ensure os is supported
    if [ ${#__SUPPORTED_OS[@]} -ne 0 ]; then
        _os=$(common::get_os)
        if [[ ! " ${__SUPPORTED_OS[*]} " =~ " ${_os} " ]]; then
            common::error_exit "unsupported os: $_os [supported: ${__SUPPORTED_OS[*]}]"
        fi
    fi
 
    # ensure architecture is supported
    if [ ${#__SUPPORTED_ARCH[@]} -ne 0 ]; then
        _arch=$(common::get_arch)
        if [[ ! " ${__SUPPORTED_ARCH[*]} " =~ " ${_arch} " ]]; then
            common::error_exit "unsupported architecture: $_arch [supported: ${__SUPPORTED_ARCH[*]}]"
        fi
    fi
    
    #test common::is_arm && common::log "ARM" || common::log "INTEL"

    __map_commands
}

function main() {
    # variables
    input_file="-"
    output_file=""
    config_file=
    console_output=false
    dryrun=false
    __sep_char="="
    __comment_char="#"

    # parse commandline
    while getopts "hdf:o:e:s:c:" OPTION; do
        case "$OPTION" in
            h) _usage; exit 0;;
            d) dryrun=true;;
            f) input_file=$OPTARG;;
            o) output_file=$OPTARG;;
            e) config_file=$OPTARG;;
            s) __sep_char=$OPTARG;;
            c) __comment_char=$OPTARG;;
            ?) _usage error;;
         esac
    done
    shift $((OPTIND-1))

    # pre-escape the separator and comment char once for safe use in patterns
    __sep_re=$(_escape_re "$__sep_char")
    __cc_re=$(_escape_re "$__comment_char")

    # read config from stdin when the input is "-" (the default). slurp it into
    # a temp file so the sed/grep machinery has a real file to work on, and -
    # unless the caller named an explicit -o target - send the result to stdout.
    local stdin_tmp=""
    if [ "$input_file" == "-" ]; then
        stdin_tmp=$(mktemp -t "$__APPNAME.XXXXXXXXXX")
        $__CAT > "$stdin_tmp"
        input_file="$stdin_tmp"
        # default to stdout, unless -o names a file or this is a dry run
        [ -z "$output_file" ] && [ "$dryrun" != "true" ] && output_file="-"
    fi

    # check if file exists
    [[ -e "$input_file" ]] || common::error_exit "file not found : [-f $input_file] - please specify file to be updated"

    # a friendly name for the input, used in dry-run diff labels
    local src_name
    if [ -n "$stdin_tmp" ]; then src_name="(stdin)"; else src_name="$input_file"; fi

    # decide where edits are applied. dry run and console output both edit a
    # throwaway copy so the real input is never touched; a plain -o edits the
    # named output file; otherwise the edit is in place.
    local diff_original=""
    if [ "$dryrun" == "true" ]; then
        diff_original="$input_file"
        local _work
        _work=$(mktemp -t "$__APPNAME.XXXXXXXXXX")
        cp -f "$input_file" "$_work"
        input_file="$_work"
    elif [[ ! -z "$output_file" ]]; then
        if [ "$output_file" == "-" ]; then
            #print output to console
            console_output=true
            output_file=$(mktemp -t "$__APPNAME.XXXXXXXXXX")
        fi
        cp -f "$input_file" "$output_file"
        input_file="$output_file"
    fi

    # read commands from external file
    if [[ ! -z "$config_file" ]]; then
        [[ -e "$config_file" ]] || common::error_exit "external config file not found : [-e $config_file]"
        local _line _trimmed
        # read -r keeps backslashes literal; the "|| [[ -n ]]" guard runs the
        # last line even when the file has no trailing newline
        while IFS= read -r _line || [[ -n "$_line" ]]; do
            # strip leading blanks so indented lines and the comment check work
            _trimmed="${_line#"${_line%%[![:blank:]]*}"}"
            # skip blank lines and lines that start with the comment char.
            # note: a comment char *inside* a command (e.g. a url fragment) is
            # data, not a comment, so we only look at the first character.
            [[ -z "$_trimmed" ]] && continue
            [[ "$_trimmed" == "$__comment_char"* ]] && continue
            _change_config "$_trimmed"
        done < "$config_file"
    fi

    # iterate through commands passed via commandline
    while test ${#} -gt 0; do
        _change_config "$1"
        shift
    done

    # emit results
    if [ "$dryrun" == "true" ]; then
        # show a unified diff of what would change; write nothing
        diff -u -L "$src_name" -L "$src_name (confix)" "$diff_original" "$input_file"
        rm -f "$input_file"
    elif [ "$console_output" == "true" ]; then
        $__CAT "$output_file"
        rm -f "$output_file"
    fi

    # macOS uses "sed -i .SUFFIX", which leaves a backup next to the edited
    # file (GNU sed with a bare -i leaves none). remove it so an in-place edit
    # cleans up after itself instead of littering the filesystem.
    local backup_file="${input_file}.${__TIMESTAMP}"
    if [ -f "$backup_file" ]; then
        rm -f "$backup_file"
    fi

    # clean up the temp file used to buffer stdin
    [ -n "$stdin_tmp" ] && rm -f "$stdin_tmp"
}

##
function _usage() {
    if [ "$1" != "error" ]; then
        echo "$__APPNAME $__APPVERSION, pure bash script to modify/update configuration files"
    fi
    cat << EOF
Usage: $__APPNAME [OPTIONS]... [commands1] [commands2]
Options:
-------
    -h                          
        show this message
        
    -f <file_name>
        name of the file that needs to be modified
        "-" (or omitting -f) reads the config from stdin and, unless -o
        names a file, writes the result to stdout

    -o <output_file>
        default behavior is to edit/modify the file_name
        "-" prints the modifications to console without updating file_name

    -d
        dry run: print a unified diff of what would change and write nothing

    -e <external_command_file>                            
        pick up edit commands from external file. 
        this file should contain one command per line
                
    -s <separator_character>            
        default value is "="
        
    -c <comment_character>
        default value is "#"


Commands:
--------
    each positional argument (and each line of a -e file) is one command;
    the first character selects the operation:

    key=value       update an existing key (no action if the key is absent)
    >key=value      set the key, appending it to the file if it is absent
    >key            uncomment an existing key
    <key            comment out an existing key (the line is kept)
    !key            delete the key's line entirely (active or commented)


Examples:
--------
    - remove (comment out) an existing config element
    $__APPNAME -c '#' -s':' -f cassandra.yaml "<gc_warn_threshold_in_ms"

    - delete a config element entirely (removes the line)
    $__APPNAME -s':' -f cassandra.yaml "!gc_warn_threshold_in_ms"

    - uncomment an existing config element (no action if the config key does not exist)
    $__APPNAME -s':' -f cassandra.yaml ">concurrent_compactors"

    - add a new config to the end of the file (or update existing config) 
    $__APPNAME -s':' -f cassandra.yaml ">new_param=/some/val"

    - update the value of an existing config element
    $__APPNAME -s':' -f cassandra.yaml "gc_warn_threshold_in_ms=2001"

    - multiple commands
    $__APPNAME -s':' -f cassandra.yaml "gc_warn_threshold_in_ms=2001" ">concurrent_compactors" "commitlog_directory=/change/commitlog"
  
    - prints the modifications to console without updating the original file
    $__APPNAME -o- -f log4j.properties "log4j.logger.com.endeca.itl.web.metrics=DEBUG" 
    
    - save the modifications to a different file
    $__APPNAME -olog4j-dev.properties -f log4j.properties "log4j.logger.com.endeca.itl.web.metrics=DEBUG"
    
    - specify the edit/update commands via external file (log4j.cf) instead of commandline
    $__APPNAME -o- -e log4j.cf -f log4j.properties
    
EOF
    if [ "$1" == "error" ]; then
        exit 1
    fi
}

##
# @info     escape a string for literal use inside a POSIX basic regex
#           (sed/grep pattern side). handles . * [ ] ^ $ \ and the / delimiter.
##
function _escape_re() { printf '%s' "$1" | sed 's/[][\.*^$/]/\\&/g'; }

##
# @info     escape a string for literal use on the replacement side of a
#           sed s/// command with a / delimiter. handles \ & and /.
##
function _escape_repl() { printf '%s' "$1" | sed 's/[&/\]/\\&/g'; }

##
# @info     split a command into key/value on the FIRST '=' only, so values
#           may contain spaces and further '=' characters. sets the globals
#           __pkey, __pval and __phaseq (1 when an '=' was present).
##
function _parse_cmd() {
    if [[ "$1" == *=* ]]; then
        __pkey="${1%%=*}"
        __pval="${1#*=}"
        __phaseq=1
    else
        __pkey="$1"
        __pval=""
        __phaseq=0
    fi
}

function _change_config() {
    local _cmd="$1"

    if [[ $_cmd == ">"* ]]; then
        _add_config "${_cmd#">"}"
    elif [[ $_cmd == "<"* ]]; then
        _remove_config "${_cmd#"<"}"
    elif [[ $_cmd == "!"* ]]; then
        _delete_config "${_cmd#"!"}"
    else
        _update_config "$_cmd"
    fi
}

function _update_config() {
    _parse_cmd "$1"
    local _key="$__pkey"
    local _val="$__pval"
    [[ -z "$_key" ]] && return

    local _key_re=$(_escape_re "$_key")
    local _val_re=$(_escape_repl "$_val")

    local _key_status=$(_rexists_config "$_key")
    if [ "$_key_status" -eq "2" ]; then
        _remove_comment "$_key"
    fi

    $__SED "s/^\([[:blank:]]*${_key_re}[[:blank:]]*${__sep_re}[[:blank:]]*\).*/\1${_val_re}/" "$input_file"
}

function _add_config() {
    _parse_cmd "$1"
    local _key="$__pkey"
    local _val="$__pval"
    local _haseq="$__phaseq"
    [[ -z "$_key" ]] && return

    if [ "$_haseq" -eq 0 ]; then
        # ">key" form - uncomment an existing key
        _remove_comment "$_key"
    else
        local _key_status=$(_rexists_config "$_key")
        if [ "$_key_status" -eq "0" ]; then
            #key doesn't exist - add it on its own line at the end of the file.
            #only add a separating newline when the file is non-empty and does
            #not already end in one, so repeated appends don't leave blank lines.
            if [ -s "$input_file" ] && [ -n "$(tail -c 1 "$input_file")" ]; then
                printf '\n' >> "$input_file"
            fi
            printf '%s%s%s\n' "$_key" "$__sep_char" "$_val" >> "$input_file"
        else
            _update_config "$1"
        fi
    fi
}

function _remove_config() {
    _parse_cmd "$1"
    local _key="$__pkey"
    [[ -z "$_key" ]] && return

    if [ "$(_rexists_config "$_key")" -eq "1" ]; then
        _add_comment "$_key"
    fi
}

function _delete_config() {
    _parse_cmd "$1"
    local _key="$__pkey"
    [[ -z "$_key" ]] && return

    local _key_re=$(_escape_re "$_key")
    # remove the line entirely, whether the key is active or commented out.
    # any value given (!key=value) is ignored - deletion is by key.
    $__SED "/^[[:blank:]]*${__cc_re}*[[:blank:]]*${_key_re}[[:blank:]]*${__sep_re}/d" "$input_file"
}

function _add_comment() {
    [[ -z "$1" ]] && return    || local _key="$1"
    local _key_re=$(_escape_re "$_key")
    $__SED "/^[[:blank:]]*${_key_re}[[:blank:]]*${__sep_re}/s/^/${__comment_char}/" "$input_file"
}

function _remove_comment() {
    [[ -z "$1" ]] && return    || local _key="$1"
    local _key_re=$(_escape_re "$_key")
    $__SED "s/^[[:blank:]]*${__cc_re}*[[:blank:]]*\(${_key_re}[[:blank:]]*${__sep_re}\)/\1/" "$input_file"
}

function _rexists_config() {
    [[ -z "$1" ]] && return    || local _key="$1"
    local _key_re=$(_escape_re "$_key")
    if $__GREP -q "^[[:blank:]]*${_key_re}[[:blank:]]*${__sep_re}" "$input_file"; then
        common::debug exists-uncommented
        echo 1
    elif $__GREP -q "^[[:blank:]]*${__cc_re}*[[:blank:]]*${_key_re}[[:blank:]]*${__sep_re}" "$input_file"; then
        common::debug exists-commented
        echo 2
    else
        common::debug doesnot-exist
        echo 0
    fi
}

#trap _cleanup 1 2 3 4 6 8 10 12 13 15
__init
main "$@"
exit 0
